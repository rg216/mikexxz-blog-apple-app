      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかりません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到页面"
          }
        }
      }
    },
    "Not completed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未完成"
          }
        }
      }
    },
    "Please wait a moment and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく待ってから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等片刻再试。"
          }
        }
      }
    },
    "Posts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文章"
          }
        }
      }
    },
    "Posts without a translation in this language are hidden from lists. Opening one shows the original.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語の翻訳がない記事は一覧に表示されません。開くと原文が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有这种语言译文的文章不出现在列表里；打开时显示原文。"
          }
        }
      }
    },
    "Read the Original": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文を読む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读原文"
          }
        }
      }
    },
    "Replying to @%@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ への返信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复 @%@"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索"
          }
        }
      }
    },
    "Search Posts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事を検索"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索文章"
          }
        }
      }
    },
    "Search titles, tags and text in %@. Type a tag's name to filter by it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の記事のタイトル、タグ、本文を検索します。タグ名を入力するとタグで絞り込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@文章的标题、标签和正文里搜索。输入标签名可以按标签筛选。"
          }
        }
      }
    },
    "Server Unavailable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器暂时不可用"
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请重试。"
          }
        }
      }
    },
    "Tags": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签"
          }
        }
      }
    },
    "The blog has changed in a way this version of the app doesn't understand. Update the app from the App Store.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブログのデータ形式が変わり、このバージョンのアプリでは読み込めません。App Store でアップデートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "博客的数据格式变了，这个版本的 App 读不懂。请在 App Store 更新 App。"
          }
        }
      }
    },
    "The blog's server didn't respond properly. Try again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブログのサーバーが正しく応答しませんでした。しばらくしてから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "博客的服务器没有正常响应，请稍后再试。"
          }
        }
      }
    },
    "The original has been updated since this translation was made.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳後に原文が更新されています。内容が最新でない可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文在翻译之后更新过，译文可能不是最新的。"
          }
        }
      }
    },
    "There are no posts in %@ here yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはまだ%@の記事がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有%@文章。"
          }
        }
      }
    },
    "This comment was deleted by its author.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコメントは投稿者によって削除されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此评论已被作者删除。"
          }
        }
      }
    },
    "This page doesn't exist or is no longer published.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは存在しないか、公開が終了しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个页面不存在，或者已经不再公开。"
          }
        }
      }
    },
    "This post isn't available in %@ yet. Showing the original in %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記事はまだ%@に翻訳されていません。%@の原文を表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这篇文章还没有%@版本，下面是%@原文。"
          }
        }
      }
    },
    "This post was machine-translated from %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記事は%@の原文を機械翻訳したものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本文由%@原文机器翻译。"
          }
        }
      }
    },
    "Titles, tags and text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、タグ、本文"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题、标签和正文"
          }
        }
      }
    },
    "Too Many Requests": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Update Required": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新 App"
          }
        }
      }
    },
    "You're Offline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络连接"
          }
        }
      }
