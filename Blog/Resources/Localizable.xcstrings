    "tag-list-separator": {
      "comment": "列表里标签名之间的分隔符",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
