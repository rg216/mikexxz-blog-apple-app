          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有标签"
          }
        }
      }
    },
    "No comments yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだコメントはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有评论。"
          }
        }
      }
    },
